.unified-ui .growth-cost-name { font-size: 26px; color: rgb(245, 235, 217); margin-right: 16px; }
.bg-equipment { background-image: url("../ChibiSkin/hall.png"); }
.unified-ui .equipment-page { flex-direction: row; min-height: 0; }
.unified-ui .equipment-worn-panel { width: 430px; flex-shrink: 0; margin-right: 20px; padding: 20px; }
.unified-ui .equipment-inventory-panel { flex-grow: 1; flex-basis: 0; min-width: 0; padding: 24px; margin-right: 20px; }
.unified-ui .equipment-detail-panel { width: 410px; flex-shrink: 0; padding: 24px; }
.unified-ui .equipment-section-title { font-size: 32px; color: rgb(241, 208, 139); margin-bottom: 20px; flex-shrink: 0; }
.unified-ui .equipment-hero-selector { margin-bottom: 16px; min-height: 58px; font-size: 26px; flex-shrink: 0; }
.unified-ui .equipment-hero-choice { flex-direction: row; align-items: center; min-height: 128px; margin-bottom: 12px; padding: 12px; border-width: 2px; border-color: rgb(145,122,83); border-radius: 10px; background-color: rgb(29,29,33); flex-shrink: 0; }
.unified-ui .equipment-hero-choice.equipment-selected { border-color: rgb(241,208,139); background-color: rgb(57,51,40); }
.unified-ui .equipment-hero-identity { flex-direction: row; align-items: center; margin-bottom: 24px; }
.unified-ui .equipment-hero-face { width: 84px; height: 100px; flex-shrink: 0; margin-right: 16px; }
.unified-ui .equipment-hero-name { font-size: 26px; color: rgb(245,235,217); white-space: normal; }
.unified-ui .equipment-slot-button { padding: 0; margin: 0 0 18px; background-color: rgba(0,0,0,0); border-width: 0; flex-shrink: 0; }
.unified-ui .equipment-page .growth-equipment-card { min-height: 132px; flex-grow: 0; }
.unified-ui .equipment-page .growth-equipment-art { width: 88px; height: 88px; margin-right: 14px; }
.unified-ui .equipment-page .growth-equipment-type, .unified-ui .equipment-page .growth-equipment-effect { font-size: 24px; }
.unified-ui .equipment-filters { flex-shrink: 0; }
.unified-ui .equipment-inventory-scroll { min-height: 0; }
.unified-ui .equipment-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.unified-ui .equipment-stock-tile { width: 186px; height: 216px; margin: 0 14px 14px 0; padding: 12px; border-width: 2px; border-radius: 10px; background-color: rgb(29,29,33); align-items: center; flex-shrink: 0; }
.unified-ui .equipment-stock-tile .growth-equipment-art { width: 96px; height: 96px; margin: 0 0 8px; }
.unified-ui .equipment-item-name { font-size: 24px; color: rgb(245,235,217); white-space: normal; -unity-text-align: middle-center; }
.unified-ui .equipment-item-count { font-size: 24px; color: rgb(184,169,145); margin-top: 8px; }
.unified-ui .equipment-stock-tile.equipment-selected { border-width: 4px; background-color: rgb(57,51,40); }
.unified-ui .equipment-slot-button.equipment-selected .growth-equipment-card { border-width: 4px; }
.unified-ui .equipment-detail-name { font-size: 34px; color: rgb(245,235,217); white-space: normal; }
.unified-ui .equipment-detail-panel .growth-equipment-card { margin-top: 24px; }
.unified-ui .equipment-detail-actions { margin-top: auto; flex-shrink: 0; }
.unified-ui .equipment-detail-actions .btn { margin-top: 16px; width: 100%; }
.unified-ui .equipment-empty { font-size: 26px; color: rgb(184,169,145); white-space: normal; margin-top: 24px; }
.unified-ui .equipment-current, .unified-ui .equipment-shards { font-size: 24px; color: rgb(184,169,145); white-space: normal; margin-top: 20px; }
.page-root .unity-scroller--vertical { width: 16px; min-width: 16px; flex-shrink: 0; flex-direction: column; align-self: stretch; background-color: rgb(26,26,30); border-radius: 8px; }
.page-root .unity-scroller--vertical .unity-button { display: none; }
.page-root .unity-scroller--vertical .unity-base-slider { flex-grow: 1; flex-shrink: 1; min-height: 0; flex-direction: column; }
.page-root .unity-scroller--vertical .unity-base-field__input { flex-grow: 1; min-height: 0; align-self: stretch; }
.page-root .unity-scroller--vertical .unity-base-slider__drag-container { position: relative; flex-grow: 1; min-height: 0; background-color: rgb(26,26,30); border-radius: 8px; }
.page-root .unity-scroller--vertical .unity-base-slider__dragger { position: absolute; left: 2px; right: 2px; min-width: 12px; min-height: 36px; background-color: rgb(155,128,76); border-radius: 6px; }
.page-root .unity-scroller--vertical .unity-base-slider__dragger:hover { background-color: rgb(214,170,88); }
.page-root .unity-scroller--vertical .unity-base-slider__dragger-border { display: none; }
.equipment-hero-picker .ui-help-panel { height: 80%; overflow: hidden; }
.equipment-hero-picker .ui-help-heading { flex-shrink: 0; }
.equipment-hero-picker .ui-help-content { flex-grow: 1; min-height: 0; }
.equipment-hero-picker .unity-scroll-view__content-container { padding-right: 12px; }
.unified-ui .equipment-filters .seg-tab, .unified-ui .equipment-filters .seg-tab:hover, .unified-ui .equipment-filters .seg-tab:active { background-image: none; background-color: rgb(40,40,44); border-width: 2px; border-color: rgb(145,122,83); color: rgb(245,235,217); }
.unified-ui .equipment-filters .seg-tab:hover, .unified-ui .equipment-stock-tile:hover, .unified-ui .equipment-hero-choice:hover { background-color: rgb(58,53,46); }
.unified-ui .equipment-filters .seg-tab.tab-on, .unified-ui .equipment-filters .seg-tab.tab-on:hover, .unified-ui .equipment-filters .seg-tab.tab-on:active,
.unified-ui .equipment-stock-tile.equipment-selected, .unified-ui .equipment-stock-tile.equipment-selected:hover,
.unified-ui .equipment-hero-choice.equipment-selected, .unified-ui .equipment-hero-choice.equipment-selected:hover { background-image: none; background-color: rgb(72,62,47); border-color: rgb(214,170,88); color: rgb(248,220,163); }
.unified-ui .equipment-slot-button:hover .growth-equipment-card { background-color: rgb(58,53,46); }
.unified-ui .equipment-slot-button.equipment-selected .growth-equipment-card { background-color: rgb(72,62,47); }
.page-root .hero-figure { background-image: none; overflow: visible; }
.page-root .hero-figure-image { position: absolute; background-size: contain; background-position: center center; background-repeat: no-repeat; }
.unified-ui .dungeon-frame {
    flex-grow: 1; flex-basis: 0; min-height: 0; width: 100%; padding: 20px 18px 12px;
    background-color: rgba(29, 29, 33, 0.88); border-width: 2px;
    border-color: rgb(145, 122, 83); border-radius: 18px;
}
.unified-ui .dungeon-frame .challenge-tabs { flex-shrink: 0; margin-bottom: 12px; }
.unified-ui .dungeon-frame .dun-row { margin: 8px 0; align-items: stretch; }
.unified-ui .dungeon-frame .dun-card { width: 320px; margin: 0 8px 16px; opacity: 1; }
.unified-ui .dungeon-frame .dun-head { height: 104px; flex-shrink: 0; justify-content: center; padding: 12px 8px; }
.unified-ui .dungeon-frame .dun-name { font-size: 26px; white-space: nowrap; }
.unified-ui .dungeon-frame .dun-sub { font-size: 22px; color: rgb(205, 195, 176); margin-top: 6px; -unity-text-align: middle-center; }
.unified-ui .dungeon-frame .dun-art { height: 166px; flex-shrink: 0; }
.unified-ui .dungeon-frame .dun-reward { flex-direction: row; flex-wrap: nowrap; justify-content: center; }
.unified-ui .dungeon-frame .dun-resource { align-items: center; width: 92px; margin: 0 3px; }
.unified-ui .dungeon-frame .dun-resource .item-tile { width: 84px; height: 84px; margin: 0; border-width: 1px; }
.unified-ui .dungeon-frame .dun-resource-name { font-size: 22px; color: rgb(245, 235, 217); -unity-text-align: middle-center; margin-top: 8px; }
.unified-ui .dungeon-frame .card-body { padding: 14px 8px 8px; min-height: 120px; }
.unified-ui .dungeon-frame .dun-lock, .unified-ui .dungeon-frame .dun-center { height: 30px; margin: 0; font-size: 22px; -unity-text-align: middle-center; }
.unified-ui .dungeon-frame .dun-stamina { flex-direction: row; align-items: center; justify-content: center; margin-top: 10px; }
.unified-ui .dungeon-frame .dun-stamina .dun-resource-name { margin: 0 10px 0 0; }
.unified-ui .dungeon-frame .card-footer { padding: 6px 8px 0; }
.unified-ui .dungeon-frame .card-footer .btn { min-width: 0; width: 264px; margin: 4px 0; }
