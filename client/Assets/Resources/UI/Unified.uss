.unified-ui .btn, .unified-ui .btn-done, .unified-ui .tab, .unified-ui .challenge-tab {
    background-image: none; background-color: rgb(40, 40, 44); color: rgb(245, 235, 217);
    border-width: 1px; border-color: rgb(145, 122, 83); border-radius: 12px;
    -unity-text-outline-width: 0; scale: 1 1; translate: 0 0;
}
.unified-ui .btn:hover, .unified-ui .tab:hover, .unified-ui .challenge-tab:hover {
    background-color: rgb(58, 53, 46); border-color: rgb(214, 170, 88);
}
.unified-ui .btn:active { background-color: rgb(72, 62, 47); }
.unified-ui .tab-on, .unified-ui .tab-on:hover,
.unified-ui .challenge-tab.active, .unified-ui .challenge-tab.active:hover {
    background-image: none;
    background-color: rgb(72, 62, 47); color: rgb(248, 220, 163);
    border-color: rgb(214, 170, 88); border-bottom-width: 3px;
}
.unified-ui .challenge-tab { -unity-text-align: middle-center; }
.unified-ui .btn-primary, .unified-ui .btn-on {
    background-image: url("../ChibiSkin/gold.png"); background-color: rgb(205, 165, 78);
    border-width: 0; border-radius: 14px; color: rgb(48, 32, 16);
    -unity-slice-left: 100; -unity-slice-right: 100; -unity-slice-top: 60; -unity-slice-bottom: 60;
    -unity-slice-scale: 0.2px; -unity-background-image-tint-color: white;
}
