.meta-page.bg-home .strategy-home-top { left: 0; right: 48px; top: 20px; height: 96px; justify-content: space-between; }
.meta-page.bg-home .home-player { border-left-width: 0; border-top-left-radius: 0; border-bottom-left-radius: 0; }
.meta-page.bg-home .res-pill:last-child { border-right-width: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; }
.meta-page.bg-home .home-hero-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.meta-page.bg-home .home-res .res-pill { height: 72px; min-width: 204px; padding: 6px 16px; }
.meta-page.bg-home .home-res .res-pill-icon { width: 48px; height: 48px; }
.meta-page.bg-home .home-res .res-pill-text { font-size: 32px; }
.meta-page.bg-home .home-equipment-icon { width: 124px; height: 124px; margin-top: -11px; margin-bottom: -11px; }
.meta-page.bg-home .home-hero { position: absolute; left: 50%; translate: -50% 0; bottom: 180px; width: 760px; height: 760px; }
.meta-page.bg-home .home-hero-switch { position: absolute; left: 50%; margin-left: 276px; bottom: 230px; width: 68px; height: 68px; min-height: 68px; margin-top: 0; margin-right: 0; margin-bottom: 0; padding: 0; align-items: center; justify-content: center; background-image: none; background-color: rgba(35, 35, 39, 0.94); border-width: 2px; border-color: rgb(189, 153, 87); border-radius: 34px; scale: 1 1; }
.meta-page.bg-home .home-hero-switch-icon { margin: 0; padding: 0; font-size: 46px; color: rgb(241, 208, 139); -unity-text-align: middle-center; scale: 1 1;  }
.meta-page.bg-home .home-hero-switch:hover .home-hero-switch-icon { scale: 1 1; }
.meta-page.bg-home .home-featured { position: absolute; right: 24px; top: 140px; width: 520px; height: 220px; background-color: rgba(20, 24, 40, 0.92); background-size: cover; border-width: 2px; border-color: rgb(214, 170, 88); border-radius: 12px; overflow: hidden; }
.meta-page.bg-home .home-featured-heroes { position: absolute; right: 4px; bottom: 0; width: 390px; height: 212px; flex-direction: row; align-items: flex-end; }
.meta-page.bg-home .home-featured-art { position: relative; width: 210px; height: 210px; margin-left: -15px; flex-shrink: 0; background-position: center bottom; background-repeat: no-repeat; background-size: contain; }
.meta-page.bg-home .home-featured-tag { position: absolute; left: 16px; top: 12px; padding: 4px 14px; font-size: 26px; color: rgb(48, 32, 16); background-color: rgb(224, 190, 118); border-radius: 6px; }
.meta-page.bg-home .home-featured-name { position: absolute; left: 0; right: 0; bottom: 0; padding: 6px 16px; background-color: rgba(0, 0, 0, 0.5); font-size: 38px; color: rgb(250, 240, 214); -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(0, 0, 0, 0.8); }
.meta-page.bg-home .home-departure { position: absolute; left: auto; top: auto; right: 24px; bottom: 236px; width: 420px; height: 134px; margin: 0; padding: 0; background-image: none; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.meta-page.bg-home .home-departure .home-primary { width: 100%; height: 134px; min-height: 134px; margin: 0; padding: 0; flex-direction: row; align-items: center; justify-content: center; background-image: url("../ChibiSkin/gold.png"); background-color: rgb(205, 165, 78); border-width: 0; border-radius: 14px; -unity-background-image-tint-color: rgb(255, 255, 255); -unity-slice-left: 100; -unity-slice-right: 100; -unity-slice-top: 60; -unity-slice-bottom: 60; -unity-slice-scale: 0.2px; scale: 1 1; translate: 0 0; }
.meta-page.bg-home .home-departure .home-sortie-art { width: 94px; height: 104px; margin: 0 14px 0 0; scale: 1 1; transform-origin: 50% 50%;  -unity-background-scale-mode: scale-to-fit; }
.meta-page.bg-home .home-departure .home-primary:hover .home-sortie-art { scale: 1 1; }
.meta-page.bg-home .home-departure .home-primary-title { width: 120px; height: 64px; flex-shrink: 0; margin: 0; padding: 0; font-size: 52px; -unity-font-style: normal; color: rgb(48, 32, 16); -unity-text-align: middle-center; }
