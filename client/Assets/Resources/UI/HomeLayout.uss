.meta-page.bg-home .strategy-home-top { left: 0; right: 0; top: 14px; justify-content: space-between; }
.meta-page.bg-home .home-player { border-left-width: 0; border-top-left-radius: 0; border-bottom-left-radius: 0; }
.meta-page.bg-home .res-pill:last-child { border-right-width: 0; border-top-right-radius: 0; border-bottom-right-radius: 0; }
.meta-page.bg-home .home-hero-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.meta-page.bg-home .home-hero { position: absolute; left: 110px; bottom: 166px; width: 540px; height: 720px; background-position: center bottom; background-repeat: no-repeat; background-size: contain; }
.meta-page.bg-home .home-hero-switch, .meta-page.bg-home .home-hero-switch:hover { position: absolute; left: 690px; bottom: 236px; width: 190px; height: 64px; min-height: 64px; margin: 0; padding: 0; font-size: 28px; color: rgb(246, 235, 213); background-image: none; background-color: rgba(35, 35, 39, 0.94); border-width: 2px; border-color: rgb(145, 122, 83); border-radius: 32px; -unity-text-align: middle-center; }
.meta-page.bg-home .home-featured { position: absolute; right: 24px; top: 140px; width: 520px; height: 220px; background-color: rgba(20, 24, 40, 0.92); background-size: cover; border-width: 2px; border-color: rgb(214, 170, 88); border-radius: 12px; overflow: hidden; }
.meta-page.bg-home .home-featured-art { position: absolute; right: 8px; bottom: 0; width: 220px; height: 210px; background-position: center bottom; background-repeat: no-repeat; background-size: contain; }
.meta-page.bg-home .home-featured-tag { position: absolute; left: 16px; top: 12px; padding: 4px 14px; font-size: 26px; color: rgb(48, 32, 16); background-color: rgb(224, 190, 118); border-radius: 6px; }
.meta-page.bg-home .home-featured-name { position: absolute; left: 0; right: 0; bottom: 0; padding: 6px 16px; background-color: rgba(0, 0, 0, 0.5); font-size: 38px; color: rgb(250, 240, 214); -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(0, 0, 0, 0.8); }
.meta-page.bg-home .home-departure { position: absolute; left: auto; top: auto; right: 24px; bottom: 236px; width: 420px; height: 134px; margin: 0; padding: 0; background-image: none; background-color: rgba(0, 0, 0, 0); border-width: 0; }
.meta-page.bg-home .home-departure .home-primary { margin: 0; }
