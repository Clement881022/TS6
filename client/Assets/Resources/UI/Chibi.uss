.meta-page {
    background-color: rgb(15, 24, 26);
    background-image: url("../ChibiSkin/hall.png");
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(172, 180, 180);
    color: rgb(238, 229, 206);
}
.meta-page.bg-home { background-image: none; -unity-background-image-tint-color: white; }
.meta-page.bg-map { background-image: url("../ChibiSkin/map.png"); -unity-background-image-tint-color: rgb(205, 210, 198); }
.meta-page .hdr {
    height: 98px; padding: 0 32px;
    background-color: rgba(12, 22, 25, 0.97);
    border-bottom-width: 1px; border-bottom-color: rgb(155, 124, 70);
}
.meta-page .hdr-title { font-size: 44px; color: rgb(237, 211, 154); -unity-text-outline-width: 0; }
.meta-page .hdr-back, .meta-page .hdr-close {
    width: 62px; height: 62px; border-radius: 4px; border-width: 1px;
    border-color: rgb(118, 97, 63); background-color: rgb(22, 34, 36); background-image: none;
}
.meta-page .hdr-back:hover, .meta-page .hdr-close:hover { background-color: rgb(49, 57, 49); scale: 1 1; }
.meta-page .hdr-back-icon { background-image: url("../ChibiSkin/back.png"); margin: 10px; }
.meta-page .hdr-close { background-image: url("../ChibiSkin/btn_close.png"); -unity-background-scale-mode: scale-to-fit; }
.meta-page .res-pill { border-radius: 4px; border-width: 1px; border-color: rgb(82, 79, 56); background-color: rgba(12, 22, 24, 0.96); padding: 8px 16px 8px 8px; margin-left: 14px; }
.meta-page .res-pill-text { color: rgb(242, 234, 210); font-size: 28px; }
.meta-page .res-pill-icon { width: 40px; height: 40px; }
.meta-page .page-content { padding: 20px 20px 18px 20px; }

.meta-page .txt, .meta-page .line-title, .meta-page .card-row-name { color: rgb(240, 232, 212); }
.meta-page .txt-sub, .meta-page .txt-gold, .meta-page .section-text,
.meta-page .bpanel-title, .meta-page .popup-title, .meta-page .tier-title { color: rgb(222, 193, 135); }
.meta-page .txt-dim, .meta-page .line-sub, .meta-page .card-row-desc,
.meta-page .side-caption, .meta-page .cost-chip-have, .meta-page .foot-note,
.meta-page .tile-desc, .meta-page .break-row-text { color: rgb(182, 189, 177); }
.meta-page .txt-good, .meta-page .break-row-on .break-row-text { color: rgb(129, 201, 166); }
.meta-page .section-line { background-color: rgb(103, 92, 63); }
.meta-page .reddot { width: 20px; height: 20px; border-width: 2px; border-color: rgb(231, 195, 125); background-color: rgb(176, 57, 40); border-radius: 10px; }

.meta-page .bpanel, .meta-page .panel, .meta-page .popup,
.meta-page .gacha-info, .meta-page .quest-ms, .meta-page .tier {
    border-radius: 3px; border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../ChibiSkin/panel.png");
    -unity-background-image-tint-color: white;
    -unity-slice-left: 180; -unity-slice-right: 180; -unity-slice-top: 180; -unity-slice-bottom: 180;
    -unity-slice-scale: 0.18px;
    padding: 28px;
}
.meta-page .btn, .meta-page .btn:hover, .meta-page .btn-done, .meta-page .btn-done:hover,
.meta-page .tab, .meta-page .tab:hover {
    border-radius: 3px; border-width: 1px; border-color: rgb(134, 111, 70);
    background-image: none; background-color: rgb(27, 42, 43);
    color: rgb(234, 223, 194); -unity-text-outline-width: 0;
    -unity-background-image-tint-color: white;
    transition: background-color 100ms ease-out, border-color 100ms ease-out;
}
.meta-page .btn:hover, .meta-page .tab:hover { background-color: rgb(47, 58, 51); border-color: rgb(215, 182, 112); }
.meta-page .btn-primary, .meta-page .btn-primary:hover, .meta-page .btn-on, .meta-page .btn-on:hover {
    background-image: url("../ChibiSkin/gold.png"); background-color: rgba(0, 0, 0, 0);
    -unity-slice-left: 220; -unity-slice-right: 220; -unity-slice-top: 200; -unity-slice-bottom: 200;
    -unity-slice-scale: 0.15px;
    border-width: 0; color: rgb(42, 30, 17); -unity-background-image-tint-color: white;
}
.meta-page .btn-primary:hover, .meta-page .btn-on:hover { -unity-background-image-tint-color: rgb(255, 242, 210); }
.meta-page .btn:active { scale: 0.99 0.99; }
.meta-page .btn-done, .meta-page .btn-done:hover, .meta-page .btn:disabled {
    background-image: none; background-color: rgb(27, 34, 33); border-width: 1px;
    border-color: rgb(78, 79, 64); color: rgb(147, 150, 133);
}
.meta-page .tab-on, .meta-page .tab-on:hover {
    background-image: none; background-color: rgb(73, 67, 42); color: rgb(251, 225, 158);
    border-width: 1px; border-color: rgb(206, 169, 90); border-bottom-width: 3px;
}
.meta-page .item-tile { background-color: rgb(22, 34, 36); border-color: rgb(125, 105, 66); border-width: 1px; border-radius: 3px; }
.meta-page .item-count { background-color: rgba(12, 20, 22, 0.95); color: rgb(247, 235, 200); border-radius: 2px; }
.meta-page .cost-chip .item-tile { background-color: rgba(0, 0, 0, 0); }
.meta-page .cost-chip-text { color: rgb(240, 226, 186); }
.meta-page .cost-chip-bad .cost-chip-text, .meta-page .cost-chip-bad .cost-chip-have { color: rgb(243, 147, 122); }
.meta-page .bar-bg { background-color: rgb(11, 20, 21); border-width: 0; border-radius: 2px; }
.meta-page .bar-fill.bar-gold { background-color: rgb(197, 157, 80); border-radius: 2px; }
.meta-page .badge-role { background-color: rgb(41, 54, 48); color: rgb(212, 211, 185); border-radius: 3px; }

.strategy-home-shade { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(3, 13, 17, 0.10); }
.strategy-home-top { position: absolute; left: 0; right: 0; top: 0; height: 124px; background-color: rgba(10, 20, 23, 0.96); border-bottom-width: 1px; border-bottom-color: rgb(141, 114, 64); }
.meta-page .home-player { left: 30px; top: 18px; height: 90px; padding: 4px 16px; width: 354px; border-width: 0; border-radius: 0; background-color: rgba(0, 0, 0, 0); }
.meta-page .home-player .avatar { width: 76px; height: 76px; border-radius: 4px; border-width: 1px; border-color: rgb(173, 139, 76); margin-right: 18px; }
.meta-page .home-player-info { width: 215px; }
.meta-page .home-player-name { font-size: 28px; color: rgb(238, 223, 189); }
.meta-page .home-player-level { font-size: 26px; color: rgb(222, 194, 137); }
.meta-page .home-player-exp { font-size: 20px; color: rgb(169, 182, 168); }
.strategy-brand { position: absolute; top: 26px; left: 444px; }
.strategy-brand-title { font-size: 40px; -unity-font-style: bold; color: rgb(230, 200, 140); }
.strategy-brand-sub { font-size: 20px; color: rgb(172, 182, 165); margin-top: 2px; }
.meta-page .home-res { right: 30px; top: 34px; }
.meta-page .home-fn-bar { left: 28px; right: auto; top: 152px; bottom: auto; width: 274px; flex-direction: column; padding: 18px 10px; background-color: rgba(10, 21, 23, 0.94); border-width: 1px; border-color: rgb(109, 91, 57); }
.meta-page .home-fn { height: 104px; flex-direction: row; align-items: center; margin: 0 0 16px 0; padding: 0 12px; border-width: 1px; border-radius: 2px; border-color: rgb(123, 104, 68); background-color: rgb(24, 39, 42); }
.meta-page .home-fn:hover { translate: 0 0; background-color: rgb(49, 57, 46); border-color: rgb(218, 181, 107); }
.meta-page .home-fn-circle { width: 76px; height: 76px; background-image: none; }
.meta-page .home-fn-icon { width: 64px; height: 64px; }
.meta-page .home-fn-label { margin: 0 0 0 18px; padding: 0; background-color: rgba(0, 0, 0, 0); font-size: 34px; color: rgb(239, 215, 165); }
.meta-page .home-chapter { right: 32px; left: auto; top: 160px; width: 518px; min-height: 190px; padding: 28px 32px; flex-direction: column; align-items: stretch; border-width: 0; border-radius: 0; background-image: url("../ChibiSkin/panel.png"); -unity-slice-left: 180; -unity-slice-right: 180; -unity-slice-top: 180; -unity-slice-bottom: 180; background-color: rgba(0, 0, 0, 0); }
.meta-page .home-chapter:hover { scale: 1 1; background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: rgb(255, 245, 215); }
.meta-page .home-chapter-text { margin: 0; min-width: 0; align-items: stretch; }
.meta-page .home-chapter-title { font-size: 32px; color: rgb(230, 202, 145); }
.meta-page .home-chapter-sub { font-size: 25px; color: rgb(220, 223, 201); margin-top: 10px; }
.strategy-chapter-count { font-size: 22px; color: rgb(178, 185, 165); margin-top: 16px; }
.meta-page .home-chapter-progress { height: 8px; margin-top: 10px; }
.meta-page .home-orb { width: 492px; height: 246px; right: 26px; bottom: 120px; background-image: url("../ChibiSkin/expedition.png"); background-color: rgba(0, 0, 0, 0); align-items: flex-end; justify-content: flex-end; padding: 0 65px 54px 0; }
.meta-page .home-orb:hover { scale: 1.03 1.03; }
.strategy-expedition-title { font-size: 66px; -unity-font-style: bold; color: rgb(248, 224, 166); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(44, 26, 10); }
.strategy-expedition-sub { font-size: 22px; color: rgb(203, 190, 153); margin-top: 0; }
.strategy-home-footer { position: absolute; left: 0; right: 0; bottom: 0; height: 92px; background-color: rgba(10, 20, 23, 0.96); border-top-width: 1px; border-top-color: rgb(101, 90, 63); flex-direction: row; align-items: center; justify-content: space-between; padding: 0 32px; }
.strategy-home-hint { font-size: 25px; color: rgb(204, 208, 188); }
.meta-page .strategy-formation-link, .meta-page .strategy-formation-link:hover { min-height: 60px; min-width: 200px; font-size: 26px; }

.tile-ico-heroes, .nav-icon-heroes { background-image: url("../ChibiSkin/nav_heroes.png"); }
.tile-ico-gacha, .nav-icon-gacha { background-image: url("../ChibiSkin/nav_gacha.png"); }
.tile-ico-dungeons, .nav-icon-dungeons { background-image: url("../ChibiSkin/nav_dungeons.png"); }
.tile-ico-quests, .nav-icon-quests { background-image: url("../ChibiSkin/nav_quests.png"); }
.tile-ico-shop, .nav-icon-shop { background-image: url("../ChibiSkin/nav_shop.png"); }
.tile-ico-map, .nav-icon-map { background-image: url("../ChibiSkin/nav_map.png"); }
.nav-icon-home { background-image: url("../ChibiSkin/nav_home.png"); }

.meta-page.bg-heroes .page-content { padding: 22px; }
.meta-page .hero-left { width: 312px; padding: 20px 12px; margin-right: 18px; background-color: rgba(12, 23, 26, 0.97); border-width: 1px; border-color: rgb(106, 92, 64); }
.strategy-roster-title { font-size: 30px; color: rgb(224, 196, 139); padding: 0 8px; }
.strategy-roster-count { font-size: 21px; color: rgb(166, 180, 164); margin: 4px 8px 18px 8px; }
.meta-page .hero-grid { flex-direction: column; flex-wrap: nowrap; padding: 0 5px 12px 0; }
.meta-page .hero-left > .unity-scroll-view { flex-grow: 1; flex-shrink: 1; min-height: 0; }
.strategy-roster-entry { height: 140px; flex-shrink: 0; margin: 0 0 12px 0; padding: 8px; flex-direction: row; align-items: center; border-radius: 2px; border-width: 1px; border-color: rgb(81, 89, 72); background-color: rgb(26, 39, 42); }
.strategy-roster-entry:hover { border-color: rgb(183, 151, 88); background-color: rgb(43, 52, 45); }
.strategy-roster-selected, .strategy-roster-selected:hover { border-color: rgb(230, 191, 112); background-color: rgb(67, 61, 38); border-left-width: 4px; }
.strategy-roster-face { width: 98px; height: 118px; flex-shrink: 0; -unity-background-scale-mode: scale-and-crop; border-width: 1px; border-color: rgb(159, 128, 70); }
.strategy-roster-text { flex-grow: 1; flex-shrink: 1; margin-left: 14px; }
.strategy-roster-name { font-size: 26px; -unity-font-style: bold; color: rgb(239, 222, 177); white-space: normal; }
.strategy-roster-level { font-size: 20px; color: rgb(187, 193, 166); margin-top: 6px; }
.strategy-roster-stars { margin-top: 10px; }
.strategy-roster-stars .star { width: 20px; height: 20px; }
.meta-page .hero-center { flex-grow: 1; flex-shrink: 1; flex-basis: 0; margin-right: 20px; overflow: hidden; border-width: 1px; border-color: rgb(121, 105, 66); background-color: rgba(12, 24, 26, 0.45); }
.strategy-hero-art { position: absolute; left: 0; right: 0; top: 36px; bottom: 0; -unity-background-scale-mode: scale-to-fit; }
.meta-page .hero-model { width: 700px; height: 800px; top: 70px; }
.meta-page .hero-namebar { left: 24px; right: auto; top: 28px; margin: 0; padding: 14px 16px; flex-direction: column; align-items: flex-start; background-color: rgba(11, 23, 26, 0.92); border-radius: 2px; border-left-width: 2px; border-left-color: rgb(208, 171, 97); }
.meta-page .hero-namebar-name { font-size: 48px; color: rgb(247, 223, 169); margin: 10px 0; }
.meta-page .hero-namebar-level { color: rgb(214, 187, 125); font-size: 26px; margin-left: 12px; }
.meta-page .hero-namebar .hero-namebar-level { margin: 12px 0 0 0; }
.meta-page .strategy-hero-view, .meta-page .strategy-hero-view:hover { position: absolute; right: 22px; bottom: 24px; min-width: 170px; min-height: 62px; font-size: 25px; }
.strategy-hero-caption { position: absolute; bottom: 30px; left: 24px; font-size: 23px; color: rgb(239, 221, 181); background-color: rgba(11, 23, 26, 0.92); padding: 10px 14px; }
.meta-page .hero-right { width: 710px; padding: 0; flex-shrink: 0; }
.strategy-hero-summary { background-color: rgba(14, 27, 30, 0.98); border-width: 1px; border-color: rgb(130, 111, 72); padding: 22px 22px 10px 22px; margin-bottom: 18px; }
.strategy-summary-heading { flex-direction: row; align-items: center; margin-bottom: 12px; }
.strategy-summary-name { font-size: 36px; color: rgb(238, 216, 164); margin: 0 12px; -unity-font-style: bold; }
.meta-page .hero-stats { width: auto; margin: 0; padding: 12px 0; border-width: 0; border-top-width: 1px; border-top-color: rgb(71, 83, 69); border-radius: 0; background-color: rgba(0, 0, 0, 0); flex-direction: row; }
.meta-page .hero-stats-col { margin: 0 10px; }
.meta-page .stat-line { margin: 5px 0; min-height: 34px; }
.meta-page .stat-line-name { color: rgb(180, 191, 170); font-size: 23px; }
.meta-page .stat-line-val { color: rgb(237, 230, 205); font-size: 25px; }
.meta-page .hero-grade { flex-direction: row; justify-content: space-between; margin: 0 10px 0 10px; padding-top: 8px; border-top-width: 1px; border-top-color: rgb(71, 83, 69); }
.meta-page .hero-grade .star { width: 28px; height: 28px; }
.meta-page .hero-grade-text { color: rgb(182, 190, 169); font-size: 21px; }
.meta-page .seg { margin: 0 0 16px 0; }
.meta-page .tab.seg-tab, .meta-page .tab.seg-tab:hover { min-height: 76px; font-size: 29px; }
.meta-page .side-panel { flex-grow: 1; padding: 30px; }
.meta-page .side-body { flex-grow: 1; min-height: 0; }
.meta-page .side-footer { margin-top: 14px; padding-top: 12px; }
.meta-page .cost-line { margin-top: 14px; }
.meta-page .card-row { background-color: rgba(18, 32, 35, 0.90); border-left-color: rgb(141, 117, 71); border-radius: 2px; }
.meta-page .break-row-mark { color: rgb(126, 126, 99); }

.meta-page .mnode { border-width: 2px; border-color: rgb(174, 145, 87); background-color: rgb(26, 41, 41); }
.meta-page .mnode-open, .meta-page .mnode-open:hover { background-color: rgb(125, 71, 40); border-color: rgb(241, 211, 141); }
.meta-page .mnode-clear { background-color: rgb(42, 79, 64); border-color: rgb(164, 204, 157); }
.meta-page .mnode-lock { background-color: rgb(37, 48, 45); border-color: rgb(97, 105, 87); }
.meta-page .mnode-current { border-width: 4px; border-color: rgb(255, 232, 177); }
.meta-page .mnode-lockicon { background-image: url("../ChibiSkin/lock.png"); }
.meta-page .mnode-plate, .meta-page .map-info { background-color: rgba(12, 26, 27, 0.94); color: rgb(235, 220, 180); border-radius: 3px; }
.meta-page .mnode-plate-dim { color: rgb(156, 171, 147); }
.meta-page .mnode-dot { background-color: rgb(219, 194, 133); border-width: 0; width: 8px; height: 8px; }
.meta-page .gacha-card, .meta-page .gacha-card-main { border-width: 2px; border-radius: 3px; border-color: rgb(192, 155, 81); background-color: rgb(19, 32, 35); }
.meta-page .gacha-card-name { background-color: rgba(11, 22, 25, 0.94); color: rgb(242, 214, 153); }
.meta-page .pull-overlay { background-image: url("../ChibiSkin/hall.png"); -unity-background-scale-mode: scale-and-crop; background-color: rgb(13, 24, 26); }
.meta-page .pull-ring { border-width: 1px; border-color: rgba(172, 135, 63, 0.4); background-color: rgba(111, 94, 47, 0.12); }
.meta-page .htile { border-width: 2px; border-radius: 3px; background-color: rgb(24, 37, 39); border-color: rgb(127, 135, 109); }
.meta-page .htile:hover { background-color: rgb(42, 50, 42); }
.meta-page .htile-sr { border-color: rgb(156, 127, 174); }
.meta-page .htile-ur, .meta-page .htile-on { border-color: rgb(222, 180, 99); }
.meta-page .htile-on { border-width: 4px; }
.meta-page .htile-name, .meta-page .htile-level { background-color: rgba(11, 25, 27, 0.96); color: rgb(240, 224, 190); border-radius: 2px; }
.meta-page .htile-stars { background-color: rgba(11, 25, 27, 0.82); border-radius: 0; }
.meta-page .htile-rarity { background-color: rgb(83, 115, 105); border-radius: 2px; }
.meta-page .htile-rarity-sr { background-color: rgb(115, 84, 132); }
.meta-page .htile-rarity-ur { background-color: rgb(194, 150, 66); }
.meta-page .htile-role { background-color: rgba(13, 26, 27, 0.96); border-radius: 2px; }
.meta-page .dun-card, .meta-page .shop-card { border-width: 1px; border-radius: 3px; border-color: rgb(135, 111, 64); background-color: rgb(15, 30, 32); }
.meta-page .dun-head, .meta-page .shop-head { background-color: rgb(31, 48, 47); border-bottom-width: 1px; border-bottom-color: rgb(115, 102, 66); }
.meta-page .dun-name, .meta-page .shop-name { color: rgb(235, 209, 157); }
.meta-page .dun-art, .meta-page .shop-art { background-color: rgba(168, 135, 61, 0.09); }
.meta-page .shop-card-gold .shop-head { background-color: rgb(91, 76, 40); }
.meta-page .shop-card-purple .shop-head { background-color: rgb(58, 48, 68); }
.meta-page .dun-reward .item-tile { border-width: 1px; }
.meta-page .quest-done2 { background-color: rgb(50, 56, 35); }
.meta-page .slot-empty, .meta-page .formation-cell, .meta-page .formation-chip { background-image: none; background-color: rgba(14, 31, 33, 0.95); border-color: rgb(109, 117, 84); border-width: 1px; border-radius: 3px; }
.meta-page .slot-empty:hover { background-color: rgb(43, 55, 43); border-color: rgb(198, 166, 98); }
.meta-page .slot-plus { color: rgb(149, 151, 112); }
.meta-page .form-strip, .meta-page .form-toolbar { background-color: rgba(11, 25, 27, 0.96); border-color: rgb(131, 109, 64); border-radius: 2px; }
.meta-page .formation-label, .meta-page .form-strip-label { color: rgb(207, 187, 143); }
.meta-page .form-toolbar .btn { background-image: none; }

.root .header { height: 68px; background-color: rgba(10, 21, 24, 0.97); border-bottom-width: 1px; border-bottom-color: rgb(169, 136, 74); }
.root .header-title { color: rgb(234, 209, 150); font-size: 34px; }
.root .btn, .root .btn:hover { background-image: none; background-color: rgb(28, 43, 44); border-width: 1px; border-color: rgb(119, 103, 64); border-radius: 3px; color: rgb(234, 221, 186); }
.root .btn-on { background-color: rgb(86, 76, 43); border-color: rgb(206, 168, 91); }
.root .bl-left { left: 18px; top: 86px; width: 348px; padding: 14px; background-color: rgba(11, 24, 27, 0.95); border-width: 1px; border-color: rgb(119, 102, 64); }
.root .bl-end, .root .bl-end:hover { background-image: url("../ChibiSkin/gold.png"); -unity-slice-left: 220; -unity-slice-right: 220; -unity-slice-top: 200; -unity-slice-bottom: 200; background-color: rgba(0, 0, 0, 0); color: rgb(36, 29, 16); border-width: 0; border-radius: 0; font-size: 28px; }
.root .bl-cost-cap, .root .bl-pile-text { color: rgb(176, 187, 164); }
.root .bl-row, .root .bl-row:hover { background-color: rgb(24, 40, 43); border-width: 1px; border-radius: 2px; border-color: rgb(99, 107, 78); height: 72px; margin-bottom: 7px; }
.root .bl-row:hover { background-color: rgb(44, 54, 44); border-color: rgb(193, 158, 87); }
.root .bl-row-selected { background-color: rgb(77, 67, 33); border-color: rgb(225, 187, 105); }
.root .bl-row-index { color: rgb(169, 178, 147); }
.root .bl-row-name { font-size: 28px; color: rgb(239, 226, 193); }
.root .bl-row-face { border-radius: 2px; }
.root .bl-pile-btn { background-color: rgb(17, 31, 33); border-width: 1px; border-color: rgb(109, 100, 68); border-radius: 2px; }
.root .bl-pile-count { color: rgb(234, 204, 133); }
.root .bl-detail, .root .pv-panel, .root .unit-info { border-width: 1px; border-radius: 2px; border-color: rgb(184, 149, 80); background-color: rgb(14, 29, 32); }
.root .bl-d-owner, .root .bl-d-target, .root .pv-note, .root .pv-card-owner, .root .pv-card-target { color: rgb(176, 189, 170); }
.root .bl-d-use { background-color: rgb(58, 115, 82); border-radius: 2px; }
.root .bl-d-cancel { background-color: rgb(53, 67, 62); border-radius: 2px; }
.root .bl-bar { height: 180px; background-color: rgba(10, 22, 25, 0.98); border-top-width: 1px; border-top-color: rgb(162, 129, 70); }
