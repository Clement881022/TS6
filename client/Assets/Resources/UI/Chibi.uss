.root .tag-hero .tag-hp-bg { width: 72px; height: 9px; min-height: 9px; margin: 0; background-color: rgb(24, 47, 42); border-width: 1px; border-color: rgb(220, 199, 134); border-radius: 4px; }
.root .tag-hero .tag-hp-fill { height: 7px; min-height: 7px; border-radius: 3px; }
.root .tag-enemy { padding: 3px 5px; }
.root .tag-enemy .tag-face { display: none; }
.root .tag-enemy .tag-name { font-size: 16px; overflow: hidden; text-overflow: ellipsis; }
.root .tag-enemy .tag-hp-bg, .root .tag-enemy .tag-hp-fill { height: 16px; }
.root .tag-enemy .tag-hp-text { font-size: 13px; }
.root .tag-enemy .tag-intent .icon { width: 18px; height: 18px; }
.root .tag-enemy .tag-intent .chip-text { display: none; }
.root .tag-enemy .tag-extra .chip-text { font-size: 12px; }
.root .tag-enemy .tag-extra .icon { width: 16px; height: 16px; }
.root .tag-anchor-line { position: absolute; width: 1px; background-color: rgba(231, 201, 135, 0.7); transform-origin: 50% 0%; }
.root .tag-enemy .tag-role { display: none; }
.root .tag-name { font-size: 18px; white-space: nowrap; }
.root .tag-intent .ui-chip-text { font-size: 16px; white-space: nowrap; }
.meta-page .home-chapter .bar-bg { background-color: rgb(66, 82, 68); }
.meta-page .home-player .bar-bg { background-color: rgb(53, 71, 63); }
.meta-page .gacha-card { width: 300px; height: 410px; -unity-background-scale-mode: scale-to-fit; }
.meta-page .gacha-card-main { width: 330px; height: 460px; }
.meta-page .gacha-card-name { white-space: normal; height: 78px; font-size: 24px; padding: 8px 10px; -unity-text-align: middle-center; }
.meta-page .gacha-character-art { flex-grow: 1; flex-shrink: 1; min-height: 0; width: 100%; margin-top: 12px; margin-bottom: 8px; -unity-background-scale-mode: scale-to-fit; }
.meta-page .gacha-card-name { position: relative; left: auto; right: auto; bottom: auto; flex-shrink: 0; width: 100%; }

.strategy-brand-title, .strategy-expedition-title, .meta-page .hdr-title,
.meta-page .home-fn-label, .meta-page .home-chapter-title, .meta-page .hero-namebar-name,
.meta-page .strategy-summary-name, .meta-page .bpanel-title, .meta-page .popup-title,
.meta-page .dun-name, .meta-page .shop-name, .meta-page .btn, .meta-page .tab,
.root .header-title, .root .bl-end, .root .bl-d-name, .root .sts-card-name {
    -unity-font: url("../Fonts/ChibiDisplay.ttf"); -unity-font-style: normal;
}
