
.header {
    height: 76px;
    padding: 0 28px;
    background-color: rgba(12, 26, 62, 0.86);
    border-bottom-width: 2px;
    border-bottom-color: rgb(150, 182, 240);
}
.header-title { font-size: 38px; -unity-font-style: bold; color: rgb(255, 240, 200); }

.root .btn {
    min-width: 110px;
    min-height: 60px;
    margin: 0 0 0 10px;
    padding: 10px 18px 4px 18px;
    -unity-text-align: middle-center;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../UiSkin/btn_blue.png");
    -unity-slice-left: 38; -unity-slice-right: 38; -unity-slice-top: 30; -unity-slice-bottom: 30;
    -unity-background-image-tint-color: rgb(232, 238, 255);
    -unity-font-style: bold;
    color: white;
    font-size: 26px;
}
.root .btn:hover { background-color: rgba(0, 0, 0, 0); -unity-background-image-tint-color: white; }
.root .btn-on { background-image: url("../UiSkin/btn_orange.png"); }

.bottom {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0 18px 10px 18px;
}
.bottom-left { width: 210px; align-items: center; margin-bottom: 8px; }
.bottom-right { width: 210px; align-items: center; justify-content: flex-end; }
.hand { flex-grow: 1; justify-content: center; align-items: flex-end; }

.cost-label { align-items: center; margin-bottom: 8px; }
.cost-orb {
    width: 124px; height: 124px;
    align-items: center; justify-content: center;
    background-size: 100% 100%;
}
.cost-num { font-size: 66px; -unity-font-style: bold; color: white; -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(16, 30, 90); }
.cost-caption { font-size: 20px; color: rgb(220, 232, 255); margin-top: 2px; }

.pile-label {
    flex-direction: column;
    width: 196px;
    padding: 8px 12px;
    border-radius: 12px;
    background-color: rgba(10, 22, 56, 0.78);
}
.pile-row { flex-direction: row; align-items: center; margin: 2px 0; }
.pile-name { font-size: 20px; color: rgb(220, 232, 255); margin-left: 6px; flex-grow: 1; }
.pile-count { font-size: 24px; -unity-font-style: bold; color: rgb(255, 224, 140); }

.end-turn {
    width: 156px; height: 156px;
    margin: 0 0 30px 0;
    padding: 0;
    border-radius: 78px;
    border-width: 6px;
    border-color: rgb(255, 228, 156);
    background-color: rgb(206, 84, 40);
    font-size: 36px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 1px; -unity-text-outline-color: rgba(70, 20, 0, 0.6);
    transition: background-color 120ms ease-out;
}
.end-turn:hover { background-color: rgb(232, 104, 52); scale: 1 1; }
.end-turn:active { background-color: rgb(170, 66, 30); }

.log {
    left: 20px; top: 92px; bottom: auto;
    height: auto; width: 380px;
    padding: 8px 14px;
    background-color: rgba(10, 22, 56, 0.72);
}
.log-line { font-size: 20px; color: rgb(214, 226, 250); }

.card {
    width: 180px; height: 296px;
    margin: 0 5px;
    padding: 0;
    border-radius: 14px;
    border-width: 4px;
    border-color: rgb(120, 96, 60);
    background-color: rgb(248, 240, 220);
    overflow: hidden;
    transition: translate 120ms ease-out, border-color 120ms ease-out;
}
.card-attack { border-color: rgb(206, 72, 62); }
.card-heal { border-color: rgb(70, 174, 104); }
.card-support { border-color: rgb(70, 130, 222); }
.card:hover { translate: 0 -22px; border-color: rgb(255, 224, 120); }
.card-skill { background-color: rgb(252, 236, 190); }
.card-disabled { opacity: 0.5; }

.card-art {
    height: 128px;
    margin: 0;
    border-radius: 0;
    background-color: rgb(48, 56, 90);
    -unity-background-scale-mode: scale-and-crop;
}
.card-cost {
    position: absolute;
    left: 4px; top: 4px;
    width: 52px; height: 52px;
    font-size: 32px;
}
.card-tag { position: absolute; right: 6px; top: 6px; width: 34px; height: 34px; background-color: rgba(0, 0, 0, 0.5); border-radius: 17px; }
.card-owner {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 2px 8px;
    font-size: 19px;
    color: white;
    background-color: rgba(10, 20, 50, 0.62);
}
.card-name { font-size: 29px; -unity-font-style: bold; color: rgb(40, 30, 22); margin: 6px 8px 0 8px; white-space: nowrap; }
.card-target { font-size: 17px; color: rgb(110, 90, 60); margin: 0 8px; white-space: normal; }
.card-desc { margin: 4px 8px 0 8px; }
.card .chip-text { font-size: 21px; color: rgb(40, 30, 22); -unity-text-outline-width: 0px; }
.card .icon { width: 28px; height: 28px; }
.card-kw { margin: auto 8px 6px 8px; }

.tag {
    padding: 5px 8px 5px 5px;
    border-radius: 14px;
    border-width: 2px;
    background-color: rgba(10, 22, 56, 0.88);
}
.tag-main { flex-direction: row; align-items: center; }
.tag-face {
    width: 48px; height: 48px;
    margin-right: 7px;
    border-radius: 24px;
    border-width: 3px;
    -unity-background-scale-mode: scale-and-crop;
    flex-shrink: 0;
}
.tag-hero .tag-face { border-color: rgb(120, 168, 244); }
.tag-enemy .tag-face { border-color: rgb(220, 90, 90); }
.tag-column { flex-grow: 1; flex-shrink: 1; }
.tag-name-row { justify-content: flex-start; }
.tag-name { font-size: 22px; -unity-text-align: middle-left; }
.tag-hp-bg { height: 22px; border-radius: 11px; }
.tag-hp-fill { height: 22px; border-radius: 11px; }
.tag-hp-text { font-size: 17px; top: 0; }

.overlay { background-color: rgba(4, 10, 30, 0.74); }
.result-card {
    width: 680px;
    padding: 26px 40px 30px 40px;
    align-items: center;
    border-radius: 22px;
    border-width: 4px;
    border-color: rgb(255, 214, 120);
    background-color: rgba(16, 34, 82, 0.97);
}
.result-card .overlay-text {
    font-size: 92px;
    margin-bottom: 4px;
    color: rgb(255, 228, 150);
    -unity-font-style: bold;
}
.result-stars { flex-direction: row; justify-content: center; margin: 4px 0 10px 0; }
.result-star {
    width: 96px; height: 96px;
    margin: 0 6px;
    background-image: url("../UiSkin/star_off.png");
    -unity-background-scale-mode: scale-to-fit;
}
.result-star-on { background-image: url("../UiSkin/star_on.png"); }
.result-card .formation-hint { font-size: 29px; color: rgb(235, 242, 255); margin-bottom: 6px; -unity-text-align: middle-center; }
.result-buttons { flex-direction: row; flex-wrap: wrap; justify-content: center; margin-top: 18px; }
.result-buttons .btn { min-width: 170px; min-height: 76px; margin: 0 6px; font-size: 28px; }
.result-buttons .btn-primary { background-image: url("../UiSkin/btn_orange.png"); }

.field { margin-bottom: 214px; }

.card { width: 152px; height: 246px; margin: 0 4px; }
.card-art { height: 100px; }
.card-cost { width: 46px; height: 46px; font-size: 28px; }
.card-tag { width: 30px; height: 30px; border-radius: 15px; }
.card-owner { font-size: 17px; }
.card-name { font-size: 25px; margin: 4px 6px 0 6px; }
.card-target { font-size: 15px; margin: 0 6px; }
.card-desc { margin: 2px 6px 0 6px; }
.card .chip-text { font-size: 19px; }
.card .icon { width: 24px; height: 24px; }
.card:hover { translate: 0 -16px; }
.cost-orb { width: 108px; height: 108px; }
.cost-num { font-size: 58px; }
.end-turn { width: 130px; height: 130px; border-radius: 65px; font-size: 30px; margin-bottom: 24px; }
.bottom-left, .bottom-right { width: 190px; }

.bottom { padding-bottom: 6px; }
.hand {
    transform-origin: 50% 100%;
    scale: 0.78 0.78;
    translate: 0 4px;
    transition: translate 160ms ease-out;
}
.hand:hover { scale: 0.78 0.78; translate: 0 -10px; }
.card { width: 168px; height: 266px; }
.card-art { height: 108px; }
.card-name { font-size: 27px; }

.range-icon {
    align-self: flex-start;
    margin: 4px 4px 0 4px;
    padding: 3px;
    border-radius: 6px;
    background-color: rgba(30, 40, 70, 0.14);
    flex-direction: row;
    align-items: center;
}
.range-grid { flex-direction: column; }
.range-row { flex-direction: row; }
.range-cell { width: 11px; height: 9px; margin: 1px; border-radius: 2px; background-color: rgba(40, 50, 80, 0.16); }
.range-enemy .range-cell-on { background-color: rgb(214, 70, 60); }
.range-ally .range-cell-on { background-color: rgb(60, 130, 224); }
.range-move .range-cell-on { background-color: rgb(60, 180, 100); }
.range-cell-self { background-color: rgb(255, 196, 60); }
.range-text { font-size: 17px; margin-left: 6px; color: rgb(60, 50, 40); white-space: nowrap; }
.range-hp { position: absolute; right: -24px; top: 6px; width: 20px; height: 20px; }

.unit-info {
    position: absolute;
    width: 262px;
    padding: 8px 10px;
    border-radius: 10px;
    border-width: 2px;
    background-color: rgba(14, 16, 24, 0.92);
}
.unit-info-hero { border-color: rgba(80, 130, 190, 0.95); }
.unit-info-enemy { border-color: rgba(190, 80, 80, 0.95); }
.ui-title { flex-direction: row; align-items: center; margin-bottom: 4px; }
.ui-name { font-size: 24px; -unity-font-style: bold; color: rgb(246, 238, 214); margin-left: 6px; flex-grow: 1; }
.ui-role { font-size: 17px; color: rgb(170, 176, 196); }
.ui-hp { font-size: 19px; color: rgb(200, 240, 200); margin-bottom: 4px; }
.ui-grid { flex-direction: row; flex-wrap: wrap; }
.ui-stat { width: 50%; flex-direction: row; justify-content: space-between; padding-right: 10px; }
.ui-stat-name { font-size: 18px; color: rgb(160, 166, 186); }
.ui-stat-val { font-size: 18px; color: rgb(236, 238, 246); -unity-font-style: bold; }
.ui-up { color: rgb(110, 224, 130); }
.ui-down { color: rgb(240, 110, 100); }
.ui-sec { font-size: 17px; color: rgb(214, 190, 120); margin-top: 6px; margin-bottom: 2px; -unity-font-style: bold; }
.ui-status { flex-direction: row; align-items: center; margin-top: 2px; }
.ui-status-text { font-size: 17px; color: rgb(230, 232, 242); margin-left: 4px; white-space: normal; flex-shrink: 1; }
.ui-none { font-size: 17px; color: rgb(130, 136, 154); }

.tag-hero { padding: 3px 6px 3px 3px; }
.tag-hero .tag-name-row { display: none; }
.tag-hero .tag-face { width: 38px; height: 38px; border-radius: 19px; margin-right: 5px; }
.tag-hero .tag-hp-bg { margin: 0; height: 20px; }
.tag-hero .tag-hp-fill { height: 20px; }
.tag-hero .tag-hp-text { font-size: 15px; }
