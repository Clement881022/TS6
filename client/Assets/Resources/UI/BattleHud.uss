.root .bl-dock-left { position: absolute; left: 24px; bottom: 18px; width: 190px; align-items: stretch; }
.root .bl-dock-right { position: absolute; right: 24px; bottom: 18px; width: 210px; align-items: stretch; }
.root .bl-dock-left .bl-cost { align-self: center; margin: 0 0 12px 0; }
.root .bl-dock-right .bl-end, .root .bl-dock-right .bl-end:hover { width: 100%; height: 84px; margin: 0 0 12px 0; font-size: 32px; }
.root .bl-dock-left .bl-pile-btn, .root .bl-dock-right .bl-pile-btn { width: 100%; height: 96px; min-height: 96px; margin: 0; flex-grow: 0; flex-direction: row; align-items: center; justify-content: center; }
.root .bl-dock-left .bl-pile-icon, .root .bl-dock-right .bl-pile-icon { width: 64px; height: 64px; margin-right: 14px; }
.root .bl-dock-left .bl-pile-count, .root .bl-dock-right .bl-pile-count { font-size: 46px; }
.root .sts-hand { left: 236px; right: 250px; }

.root .ul-panel { position: absolute; left: 14px; top: 100px; width: 250px; padding: 6px; background-color: rgba(10, 24, 27, 0.88); border-width: 1px; border-color: rgb(142, 121, 73); border-radius: 6px; }
.root .ul-tabs { flex-direction: row; margin-bottom: 4px; }
.root .ul-tab { flex-grow: 1; flex-basis: 0; height: 46px; min-height: 46px; margin: 0 2px; padding: 0; font-size: 26px; color: white; border-width: 0; border-radius: 12px; opacity: 0.5; -unity-text-align: middle-center; }
.root .ul-tab-ally { background-color: rgb(34, 160, 64); }
.root .ul-tab-enemy { background-color: rgb(214, 36, 36); }
.root .ul-tab-on { opacity: 1; }
.root .ul-row { flex-direction: row; align-items: center; height: 64px; margin-top: 4px; padding: 4px 6px; background-color: rgba(255, 255, 255, 0.07); border-width: 1px; border-color: rgba(0, 0, 0, 0); border-radius: 4px; }
.root .ul-row:hover { background-color: rgba(255, 255, 255, 0.14); }
.root .ul-row-on { border-color: rgb(235, 191, 99); background-color: rgba(235, 191, 99, 0.16); }
.root .ul-row-dead { opacity: 0.35; }
.root .ul-face { width: 52px; height: 52px; min-width: 52px; margin-right: 8px; -unity-background-scale-mode: scale-and-crop; border-radius: 4px; background-color: rgba(0, 0, 0, 0.3); }
.root .ul-col { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.root .ul-name { font-size: 20px; height: 24px; color: rgb(245, 235, 217); white-space: nowrap; overflow: hidden; -unity-text-outline-width: 0; }
.root .ul-hp-text { font-size: 20px; height: 24px; color: white; -unity-text-outline-width: 0; }
.root .ul-hp-bg { height: 8px; border-radius: 4px; background-color: rgb(20, 20, 26); overflow: hidden; }
.root .ul-hp-fill { height: 8px; background-color: rgb(70, 170, 95); }
.root .ul-hp-fill-enemy { background-color: rgb(220, 90, 90); }
.root .unit-info { width: 330px; }

.root .tag-hp-bg, .root .tag-enemy .tag-hp-bg, .root .tag-hero .tag-hp-bg { width: 100%; height: 10px; min-height: 10px; margin: 2px 0; border-radius: 5px; overflow: hidden; }
.root .tag-hp-fill, .root .tag-hp-fill-enemy, .root .tag-hero .tag-hp-fill, .root .tag-enemy .tag-hp-fill { height: 10px; min-height: 10px; border-radius: 5px; }

.root .bl-hint, .root .toast { position: absolute; left: 25%; right: 25%; top: 100px; height: 78px; padding: 0 24px; flex-direction: row; align-items: center; justify-content: center; -unity-text-align: middle-center; font-size: 32px; color: rgb(250, 240, 214); white-space: normal; background-color: rgb(9, 19, 58); border-width: 2px; border-color: rgb(214, 170, 88); border-radius: 14px; }
