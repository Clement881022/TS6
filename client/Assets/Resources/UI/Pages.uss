
.page-root {
    flex-grow: 1;
    color: rgb(238, 232, 220);
}

.page-container {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}

.page-host {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    flex-direction: column;
    background-color: rgb(17, 15, 22);
}

.topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 96px;
    flex-shrink: 0;
    padding: 0 36px;
    background-color: rgb(30, 22, 24);
    border-bottom-width: 4px;
    border-bottom-color: rgb(176, 128, 52);
}
.topbar-left { flex-direction: row; align-items: center; }
.topbar-seal {
    width: 14px; height: 52px;
    margin-right: 16px;
    border-radius: 4px;
    background-color: rgb(190, 58, 52);
}
.topbar-title { font-size: 44px; -unity-font-style: bold; color: rgb(252, 226, 164); }
.topbar-res { flex-direction: row; align-items: center; }

.pill {
    flex-direction: row;
    align-items: center;
    margin-left: 14px;
    padding: 5px 20px 5px 14px;
    border-radius: 22px;
    border-width: 2px;
    border-color: rgb(84, 64, 44);
    background-color: rgb(14, 12, 18);
}
.pill-dot { width: 18px; height: 18px; margin-right: 10px; border-radius: 9px; border-width: 2px; border-color: rgba(255, 255, 255, 0.55); }
.pill-text { font-size: 25px; -unity-font-style: bold; color: rgb(244, 238, 226); }
.pill-gold .pill-dot { background-color: rgb(238, 190, 60); }
.pill-gold .pill-text { color: rgb(255, 214, 96); }
.pill-yuanbao .pill-dot { background-color: rgb(120, 200, 236); }
.pill-yuanbao .pill-text { color: rgb(160, 220, 246); }
.pill-stamina .pill-dot { background-color: rgb(110, 214, 140); }
.pill-stamina .pill-text { color: rgb(150, 232, 176); }
.pill-level .pill-dot { background-color: rgb(210, 90, 80); }

.page-scroll { flex-grow: 1; }
.page-body {
    align-items: center;
    padding: 28px 40px 40px 40px;
}

.nav {
    flex-direction: row;
    height: 112px;
    flex-shrink: 0;
    padding: 10px 28px;
    background-color: rgb(24, 19, 22);
    border-top-width: 3px;
    border-top-color: rgb(84, 64, 44);
}
.nav-tab {
    flex-grow: 1;
    flex-basis: 0;
    margin: 4px 6px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-radius: 16px;
    border-color: rgb(58, 46, 40);
    background-color: rgb(36, 30, 34);
    transition: background-color 120ms ease-out, border-color 120ms ease-out;
}
.nav-tab:hover { background-color: rgb(56, 44, 44); border-color: rgb(140, 104, 56); }
.nav-glyph { font-size: 34px; -unity-font-style: bold; color: rgb(160, 148, 130); margin-bottom: -2px; }
.nav-label { font-size: 26px; color: rgb(190, 180, 164); }
.nav-tab-on { background-color: rgb(150, 54, 46); border-color: rgb(236, 190, 96); }
.nav-tab-on:hover { background-color: rgb(166, 62, 52); }
.nav-tab-on .nav-glyph { color: rgb(255, 226, 150); }
.nav-tab-on .nav-label { color: white; -unity-font-style: bold; }

.txt { font-size: 27px; color: rgb(238, 232, 220); white-space: normal; margin: 3px 0; }
.txt-dim { font-size: 23px; color: rgb(168, 160, 148); white-space: normal; margin: 3px 0; }
.txt-sub { font-size: 32px; -unity-font-style: bold; color: rgb(252, 226, 164); white-space: normal; margin: 4px 0; }
.txt-warn { font-size: 25px; color: rgb(255, 160, 100); white-space: normal; margin: 3px 0; }
.txt-good { font-size: 25px; color: rgb(130, 220, 160); white-space: normal; margin: 3px 0; }
.txt-gold { font-size: 27px; color: rgb(255, 214, 96); white-space: normal; margin: 3px 0; }

.row { flex-direction: row; flex-wrap: wrap; align-items: center; margin: 4px 0; }
.row-center { justify-content: center; }
.grow { flex-grow: 1; flex-shrink: 1; }
.col { flex-direction: column; }

.section {
    flex-direction: row;
    align-items: center;
    width: 1500px;
    max-width: 100%;
    margin: 16px 0 6px 0;
}
.section-line { flex-grow: 1; height: 2px; background-color: rgba(176, 128, 52, 0.45); }
.section-text { font-size: 30px; -unity-font-style: bold; color: rgb(252, 226, 164); margin: 0 18px; }

.hint {
    width: 1500px;
    max-width: 100%;
    margin: 0 0 8px 0;
    padding: 10px 20px;
    border-radius: 10px;
    border-left-width: 5px;
    border-left-color: rgb(176, 128, 52);
    background-color: rgba(60, 46, 36, 0.55);
    font-size: 23px;
    color: rgb(200, 190, 172);
    white-space: normal;
}
.hint-warn { border-left-color: rgb(236, 130, 80); color: rgb(255, 190, 150); background-color: rgba(90, 44, 30, 0.5); }

.panel {
    width: 1500px;
    max-width: 100%;
    margin: 8px 0;
    padding: 20px 28px;
    border-radius: 18px;
    border-width: 2px;
    border-top-width: 4px;
    border-color: rgb(70, 56, 48);
    border-top-color: rgb(150, 110, 54);
    background-color: rgb(32, 27, 34);
}
.panel-dim { opacity: 0.5; }
.panel-row { flex-direction: row; align-items: center; justify-content: space-between; }
.panel-good { border-top-color: rgb(80, 170, 116); }

.page-host .btn {
    margin: 4px 6px 4px 0;
    padding: 10px 28px;
    font-size: 27px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(110, 90, 70);
    background-color: rgb(58, 48, 52);
    color: rgb(240, 234, 222);
    transition: background-color 120ms ease-out, border-color 120ms ease-out;
}
.page-host .btn:hover { background-color: rgb(82, 66, 66); border-color: rgb(190, 148, 80); }
.page-host .btn:active { background-color: rgb(44, 36, 40); }
.page-host .btn-primary {
    background-color: rgb(176, 62, 50);
    border-color: rgb(244, 196, 100);
    -unity-font-style: bold;
    color: white;
}
.page-host .btn-primary:hover { background-color: rgb(204, 78, 62); border-color: rgb(255, 224, 140); }
.page-host .btn-on { background-color: rgb(56, 128, 92); border-color: rgb(150, 230, 180); }
.page-host .btn-on:hover { background-color: rgb(70, 148, 106); }
.page-host .btn-disabled { opacity: 0.4; }
.page-host .btn-done { background-color: rgb(34, 30, 36); border-color: rgb(60, 52, 50); color: rgb(130, 124, 116); }
.page-host .btn-done:hover { background-color: rgb(34, 30, 36); border-color: rgb(60, 52, 50); }
.page-host .btn-wide { padding: 16px 52px; font-size: 32px; }

.tabs { flex-direction: row; justify-content: center; margin: 4px 0 10px 0; }
.page-host .tab {
    margin: 0 6px;
    padding: 10px 36px;
    font-size: 28px;
    border-radius: 24px;
    border-width: 2px;
    border-color: rgb(84, 68, 56);
    background-color: rgb(34, 28, 34);
    color: rgb(190, 180, 164);
}
.page-host .tab:hover { background-color: rgb(56, 44, 44); }
.page-host .tab-on { background-color: rgb(150, 54, 46); border-color: rgb(236, 190, 96); color: white; -unity-font-style: bold; }

.bar-bg { width: 100%; height: 20px; margin: 6px 0 10px 0; border-radius: 10px; border-width: 2px; border-color: rgb(64, 52, 44); background-color: rgb(12, 10, 14); }
.bar-fill { height: 100%; border-radius: 8px; background-color: rgb(84, 184, 112); }
.bar-gold { background-color: rgb(226, 170, 56); }
.bar-red { background-color: rgb(206, 78, 66); }
.bar-slim { height: 12px; border-radius: 6px; margin: 4px 0; }

.badge {
    margin: 0 8px 0 0;
    padding: 2px 14px;
    border-radius: 12px;
    font-size: 22px;
    -unity-font-style: bold;
    color: white;
    background-color: rgb(70, 70, 84);
}
.badge-r { background-color: rgb(58, 110, 190); }
.badge-sr { background-color: rgb(136, 78, 200); }
.badge-ur { background-color: rgb(214, 148, 30); color: rgb(40, 24, 8); }
.badge-new { background-color: rgb(204, 62, 56); }
.badge-up { background-color: rgb(60, 150, 100); }
.badge-role { background-color: rgb(52, 60, 84); color: rgb(200, 210, 236); }

.page-host .overlay { background-color: rgba(6, 4, 8, 0.8); }
.popup { width: 900px; align-items: center; background-color: rgb(34, 27, 32); border-color: rgb(176, 128, 52); border-top-color: rgb(244, 196, 100); }
.popup-title { font-size: 42px; -unity-font-style: bold; color: rgb(252, 226, 164); margin-bottom: 10px; white-space: normal; }

.banner {
    align-items: flex-start;
    padding: 30px 40px;
    border-color: rgb(150, 100, 48);
    border-top-color: rgb(244, 196, 100);
    background-color: rgb(52, 30, 30);
}
.banner-eyebrow { font-size: 24px; color: rgb(236, 190, 96); letter-spacing: 6px; }
.banner-title { font-size: 62px; -unity-font-style: bold; color: rgb(255, 226, 150); margin: 2px 0 4px 0; }
.banner-meta { flex-direction: row; justify-content: space-between; width: 100%; }

.tile-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 1500px; max-width: 100%; margin-top: 6px; }
.tile {
    width: 470px;
    height: 176px;
    margin: 10px;
    padding: 0;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    border-radius: 18px;
    border-width: 2px;
    border-color: rgb(70, 56, 48);
    background-color: rgb(36, 30, 36);
    transition: background-color 120ms ease-out, border-color 120ms ease-out, translate 120ms ease-out;
}
.tile:hover { background-color: rgb(58, 44, 44); border-color: rgb(214, 164, 80); translate: 0 -4px; }
.tile-icon {
    width: 104px; height: 104px;
    margin: 0 22px 0 26px;
    border-radius: 52px;
    border-width: 3px;
    border-color: rgba(255, 224, 150, 0.7);
    align-items: center; justify-content: center;
    background-color: rgb(150, 54, 46);
}
.tile-icon-text { font-size: 52px; -unity-font-style: bold; color: rgb(255, 232, 170); }
.tile-text { flex-shrink: 1; flex-grow: 1; margin-right: 18px; }
.tile-title { font-size: 44px; -unity-font-style: bold; color: white; }
.tile-desc { font-size: 23px; color: rgb(176, 166, 152); white-space: normal; }
.tile-hot .tile-icon { background-color: rgb(196, 120, 40); }
.tile-badge { position: absolute; right: 14px; top: 12px; padding: 1px 12px; border-radius: 12px; background-color: rgb(204, 62, 56); font-size: 21px; -unity-font-style: bold; color: white; }

.split { flex-direction: row; align-items: flex-start; width: 1500px; max-width: 100%; }
.split-list { width: 360px; margin-right: 18px; }
.split-detail { flex-grow: 1; flex-shrink: 1; width: auto; margin: 0; align-items: stretch; }

.hero-item {
    flex-direction: row;
    align-items: center;
    margin: 5px 0;
    padding: 10px 14px;
    border-radius: 14px;
    border-width: 2px;
    border-left-width: 8px;
    border-color: rgb(62, 50, 46);
    background-color: rgb(34, 28, 34);
    transition: background-color 120ms ease-out;
}
.hero-item:hover { background-color: rgb(52, 42, 44); }
.hero-item-on { background-color: rgb(58, 44, 40); border-color: rgb(226, 180, 90); }
.hero-item-r { border-left-color: rgb(76, 140, 226); }
.hero-item-sr { border-left-color: rgb(164, 100, 232); }
.hero-item-ur { border-left-color: rgb(255, 190, 60); }
.hero-item-text { flex-grow: 1; flex-shrink: 1; }
.hero-item-name { font-size: 29px; -unity-font-style: bold; color: white; }
.hero-item-sub { font-size: 21px; color: rgb(176, 166, 152); }

.avatar {
    width: 76px; height: 76px;
    margin-right: 14px;
    border-radius: 38px;
    border-width: 4px;
    align-items: center; justify-content: center;
    background-color: rgb(40, 36, 52);
    flex-shrink: 0;
}
.avatar-text { font-size: 38px; -unity-font-style: bold; color: white; }
.avatar-r { border-color: rgb(76, 140, 226); background-color: rgb(30, 50, 86); }
.avatar-sr { border-color: rgb(164, 100, 232); background-color: rgb(58, 34, 90); }
.avatar-ur { border-color: rgb(255, 190, 60); background-color: rgb(104, 62, 18); }
.avatar-lg { width: 120px; height: 120px; border-radius: 60px; border-width: 5px; margin-right: 24px; }
.avatar-lg .avatar-text { font-size: 62px; }

.hero-head { flex-direction: row; align-items: center; margin-bottom: 8px; }
.hero-name { font-size: 46px; -unity-font-style: bold; color: white; }

.stat-row { flex-direction: row; margin: 6px 0 4px 0; }
.stat {
    flex-grow: 1; flex-basis: 0;
    margin-right: 10px;
    padding: 8px 16px;
    border-radius: 12px;
    background-color: rgb(20, 17, 24);
}
.stat-label { font-size: 21px; color: rgb(160, 152, 140); }
.stat-value { font-size: 36px; -unity-font-style: bold; color: rgb(255, 232, 170); }

.card-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin: 5px 0;
    padding: 12px 18px;
    border-radius: 12px;
    background-color: rgb(24, 20, 28);
    border-left-width: 6px;
    border-left-color: rgb(120, 90, 54);
}
.card-row-name { font-size: 28px; -unity-font-style: bold; color: white; }
.card-row-desc { font-size: 22px; color: rgb(176, 166, 152); white-space: normal; }
.pips { flex-direction: row; margin: 2px 0; }
.pip { width: 14px; height: 14px; margin-right: 5px; border-radius: 7px; background-color: rgb(52, 46, 52); }
.pip-on { background-color: rgb(244, 190, 80); }

.star-text { font-size: 28px; color: rgb(255, 204, 70); }

.map-card { padding: 10px; border-top-width: 4px; }
.page-host .map-field { width: 1700px; max-width: 100%; height: 540px; margin-top: 4px; }
.page-host .map-dot { width: 12px; height: 12px; border-radius: 6px; background-color: rgba(226, 190, 120, 0.5); }
.page-host .map-node { border-width: 5px; border-color: rgb(255, 238, 200); transition: background-color 120ms ease-out; }
.page-host .map-node:hover { scale: 1 1; }
.page-host .map-node-open { background-color: rgb(190, 66, 54); }
.page-host .map-node-open:hover { background-color: rgb(220, 84, 66); }
.page-host .map-node-clear { background-color: rgb(56, 138, 96); border-color: rgb(190, 240, 210); }
.page-host .map-node-lock { background-color: rgb(52, 48, 58); border-color: rgb(92, 86, 96); color: rgb(130, 124, 132); }
.page-host .map-node-boss { border-color: rgb(255, 210, 90); }
.page-host .map-caption { width: 130px; font-size: 22px; color: rgb(236, 228, 212); }

.gacha-rates { flex-direction: row; flex-wrap: wrap; align-items: center; }
.rate-chip { flex-direction: row; align-items: center; margin-right: 22px; }
.pull-row { flex-direction: row; justify-content: center; margin: 14px 0; }

.pull-grid { flex-direction: row; flex-wrap: wrap; justify-content: center; width: 1500px; max-width: 100%; }
.pull-card {
    width: 262px;
    height: 150px;
    margin: 8px;
    padding: 12px 14px;
    align-items: center;
    justify-content: center;
    border-radius: 14px;
    border-width: 3px;
    background-color: rgb(30, 28, 44);
    border-color: rgb(76, 140, 226);
}
.pull-card-sr { background-color: rgb(50, 32, 78); border-color: rgb(170, 108, 240); }
.pull-card-ur { background-color: rgb(92, 58, 16); border-color: rgb(255, 204, 80); }
.pull-card-name { font-size: 30px; -unity-font-style: bold; color: white; margin-top: 6px; }
.pull-card-sub { font-size: 21px; color: rgb(220, 212, 196); }
.pull-rarity { font-size: 40px; -unity-font-style: bold; }
.pull-rarity-r { color: rgb(120, 176, 250); }
.pull-rarity-sr { color: rgb(200, 150, 255); }
.pull-rarity-ur { color: rgb(255, 214, 96); }

.quest-card { padding: 16px 26px; }
.quest-done { border-top-color: rgb(80, 170, 116); }
.reward-text { font-size: 23px; color: rgb(255, 214, 96); white-space: normal; }

.product-price { font-size: 38px; -unity-font-style: bold; color: rgb(255, 214, 96); }
.tier-row { flex-direction: row; flex-wrap: wrap; }
.tier {
    width: 280px;
    margin: 6px 10px 6px 0;
    padding: 14px 18px;
    align-items: center;
    border-radius: 14px;
    border-width: 2px;
    border-color: rgb(70, 56, 48);
    background-color: rgb(24, 20, 28);
}
.tier-ready { border-color: rgb(244, 196, 100); background-color: rgb(60, 40, 30); }
.tier-claimed { opacity: 0.55; }
.tier-title { font-size: 26px; color: rgb(190, 180, 164); }
.tier-value { font-size: 34px; -unity-font-style: bold; color: rgb(255, 214, 96); margin-bottom: 6px; }

.formation-board { align-items: center; }
.formation-cell {
    width: 280px;
    height: 78px;
    margin: 5px;
    padding: 0 10px;
    font-size: 26px;
    -unity-text-align: middle-center;
    white-space: normal;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(110, 90, 70);
    background-color: rgb(58, 48, 52);
    color: white;
}
.formation-cell:hover { background-color: rgb(82, 66, 66); border-color: rgb(190, 148, 80); }
.formation-cell-empty { background-color: rgba(34, 28, 34, 0.7); border-color: rgb(58, 48, 44); color: rgb(110, 104, 100); }
.formation-label { font-size: 26px; color: rgb(236, 190, 96); -unity-text-align: middle-center; }
.formation-chip {
    height: 60px;
    margin: 5px;
    padding: 0 20px;
    font-size: 25px;
    border-radius: 12px;
    border-width: 2px;
    border-color: rgb(110, 90, 70);
    background-color: rgb(46, 38, 44);
    color: white;
}
.formation-chip:hover { background-color: rgb(78, 62, 62); border-color: rgb(190, 148, 80); }
.formation-cell.btn-on, .formation-chip.btn-on { background-color: rgb(56, 128, 92); border-color: rgb(150, 230, 180); }

.page-container .toast {
    left: 460px; right: 460px; top: 120px;
    padding: 16px 24px;
    border-width: 2px;
    border-color: rgb(214, 164, 80);
    background-color: rgba(24, 18, 20, 0.94);
    color: rgb(255, 226, 150);
    font-size: 30px;
    white-space: normal;
}
