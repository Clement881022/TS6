/* 商業化整理：統一按鈕 / 分頁 / 卡片尺寸與間距，修正對齊。最後載入，覆寫 Pages / Theme / Pages2。
   規格（參考解析度 1920x1080）：
   - 版心左右 24px；區塊間距 12~16px
   - 字級：標題 50、卡片標題 34、內文 26、輔助 22（不再用更小的字）
   - 按鈕：標準 240x84（字 30）、小 168x64（字 26）、大 320x100（字 36）；一律 margin 0，間距由容器決定
   - 分頁：橫向 76 高、直向側欄 84 高、右側功能分頁（seg）72 高等分 */

/* ---- 按鈕：標準尺寸（連 hover / active 變體一起覆寫，才不會被 Theme.uss 的 hover 規則蓋回去）---- */
.meta-page .btn, .meta-page .btn-primary, .meta-page .btn-on, .meta-page .btn-done,
.meta-page .btn:hover, .meta-page .btn-primary:hover, .meta-page .btn-on:hover, .meta-page .btn-done:hover {
    min-width: 240px;
    min-height: 84px;
    margin: 0;
    padding: 6px 24px;
    font-size: 30px;
    white-space: nowrap;
    -unity-text-align: middle-center;
}
.meta-page .btn.btn-sm, .meta-page .btn.btn-sm:hover { min-width: 168px; min-height: 64px; padding: 4px 18px; font-size: 26px; }
.meta-page .btn.btn-lg, .meta-page .btn.btn-lg:hover,
.meta-page .btn.btn-wide, .meta-page .btn.btn-wide:hover { min-width: 320px; min-height: 100px; padding: 8px 30px; font-size: 36px; }
.meta-page .btn.btn-block, .meta-page .btn.btn-block:hover { min-width: 0; align-self: stretch; }

/* ---- 分頁 ---- */
.meta-page .tab, .meta-page .tab:hover, .meta-page .tab-on, .meta-page .tab-on:hover {
    min-width: 200px;
    min-height: 76px;
    margin: 0 8px;
    padding: 0 28px;
    font-size: 30px;
    white-space: nowrap;
    -unity-text-align: middle-center;
}
/* 右側功能分頁：三等分一排 */
.meta-page .tab.seg-tab, .meta-page .tab.seg-tab:hover {
    flex-grow: 1; flex-basis: 0;
    min-width: 0;
    min-height: 72px;
    margin: 0 4px;
    padding: 0 4px;
    font-size: 27px;
}
/* 左側直向分頁：同寬同高、單行 */
.meta-page .tab.side-tab, .meta-page .tab.side-tab:hover {
    min-width: 0;
    min-height: 84px;
    margin: 0 0 12px 0;
    padding: 0 12px;
    font-size: 32px;
}
.seg { flex-direction: row; margin: 0 -4px 12px -4px; }

/* ---- 紅點 ---- */
.reddot {
    position: absolute; right: -4px; top: -4px;
    width: 28px; height: 28px;
    border-radius: 14px; border-width: 3px; border-color: white;
    background-color: rgb(228, 52, 42);
}

/* ---- 文字 ---- */
.line-title { font-size: 28px; }
.line-sub { font-size: 24px; }
.meta-page .txt-dim { font-size: 24px; }
.foot-note { font-size: 22px; color: rgb(150, 172, 216); -unity-text-align: middle-center; margin: 6px 0 10px 0; }

/* ---- 費用 ---- */
.cost-line { flex-direction: row; align-items: center; margin: 6px 0; }
.cost-chip .item-tile { width: 48px; height: 48px; }
.cost-chip-text { font-size: 30px; margin-right: 0; }
.cost-chip-have { font-size: 24px; color: rgb(176, 196, 232); margin: 0 22px 0 4px; }
.cost-chip-bad .cost-chip-have { color: rgb(255, 150, 130); }

/* ---- 武將卡 ---- */
.htile-stars .star { width: 16px; height: 16px; }
.htile-level {
    right: 5px; bottom: 34px;
    padding: 0 8px; border-radius: 8px;
    font-size: 20px; color: white;
    background-color: rgba(8, 18, 50, 0.88);
    -unity-text-outline-width: 0px;
}
.htile-name { font-size: 22px; padding: 3px 8px; }
.htile-sm .htile-name { font-size: 21px; padding-right: 8px; }
.htile-md .htile-level { bottom: 44px; font-size: 22px; }

/* ---- 武將頁 ---- */
.hero-left { width: 470px; }
.hero-right { width: 470px; padding: 14px 24px 18px 8px; }
.side-panel { flex-grow: 0; padding: 20px 22px 22px 22px; }
.side-panel-fill { flex-grow: 1; justify-content: space-between; }
.side-body { flex-grow: 0; flex-shrink: 1; }
.side-panel-fill .side-body { flex-grow: 1; }
.side-footer { margin-top: 18px; }
.side-caption { font-size: 24px; color: rgb(184, 204, 244); margin: 2px 0 8px 0; }
.stat-line-name { font-size: 28px; }
.stat-line-val { font-size: 30px; }
.hero-stats { width: 480px; }
.break-row { flex-direction: row; align-items: center; margin: 5px 0; }
.break-row-mark { width: 30px; font-size: 26px; color: rgb(120, 146, 200); }
.break-row-text { flex-grow: 1; flex-shrink: 1; font-size: 25px; color: rgb(184, 204, 244); white-space: normal; }
.break-row-on .break-row-mark, .break-row-on .break-row-text { color: rgb(130, 232, 170); }
.card-row { flex-direction: column; align-items: stretch; justify-content: flex-start; padding: 12px 18px 14px 18px; margin: 6px 0; }
.card-row-head { flex-direction: row; align-items: center; justify-content: space-between; }
.card-row-head .btn { margin-left: 14px; flex-shrink: 0; }
.card-row-name { font-size: 28px; flex-grow: 1; white-space: nowrap; }
.card-row-desc { font-size: 23px; margin: 4px 0 6px 0; }

/* ---- 副本 / 商店：三張等高直立卡，內容撐開、按鈕貼底 ---- */
.page-centered { flex-direction: column; align-items: center; justify-content: center; flex-grow: 1; padding-bottom: 20px; }
.dun-row { flex-grow: 0; align-items: stretch; margin: 0 24px; }
.dun-card, .shop-card { width: 480px; margin: 0 14px; padding: 0 0 18px 0; justify-content: flex-start; }
.dun-head, .shop-head { padding: 12px 14px; }
.dun-name, .shop-name { font-size: 38px; }
.dun-sub { font-size: 24px; color: rgb(214, 228, 255); margin-top: 0; }
.dun-art, .shop-art { height: 200px; }
.card-body { flex-grow: 1; align-items: center; justify-content: center; padding: 10px 16px 6px 16px; }
.card-footer { flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: center; padding: 6px 12px 0 12px; }
.card-footer .btn { margin: 4px 7px; }
.dun-meta { flex-direction: row; align-items: center; justify-content: center; margin: 2px 0; }
.dun-meta .badge { margin: 0 5px; }
.dun-lock { font-size: 24px; color: rgb(255, 170, 120); margin: 2px 0; }
.dun-center { margin: 3px 14px; }
.dun-cost { justify-content: center; margin: 4px 0 2px 0; }
.shop-tiers { padding: 0 12px; }
.shop-tier-btn { min-width: 0; }
.meta-page .btn.shop-tier-btn { min-width: 0; flex-grow: 1; flex-basis: 40%; margin: 4px 6px; }

/* ---- 任務 ---- */
.quest-side { width: 260px; padding: 20px 0 0 24px; }
.quest-main { padding: 16px 28px 8px 18px; }
.quest-ms { margin-bottom: 12px; padding: 12px 16px 14px 16px; }
.quest-ms .tier-row { flex-wrap: nowrap; }
.quest-ms .tier { width: auto; flex-grow: 1; flex-basis: 0; margin: 4px 6px; padding: 10px 12px; }
.tier-title { font-size: 26px; }
.quest-grid { flex-direction: row; flex-wrap: wrap; align-content: flex-start; }
.quest-card2 {
    flex-direction: row; align-items: center;
    width: 48%; min-height: 0; height: 150px;
    margin: 0 1% 14px 1%; padding: 12px 18px;
}
.quest-rewards { flex-direction: row; flex-shrink: 0; }
.quest-rewards .item-tile { width: 84px; height: 84px; margin: 0 4px 0 0; }
.quest-info { flex-grow: 1; flex-shrink: 1; margin: 0 16px; justify-content: center; }
.quest-desc { font-size: 28px; -unity-font-style: bold; color: white; white-space: normal; }
.quest-info .bar-bg { margin: 8px 0 6px 0; }
.quest-meta { flex-direction: row; align-items: center; justify-content: space-between; }
.quest-count { font-size: 24px; color: rgb(184, 204, 244); }
.quest-action { width: 172px; flex-shrink: 0; align-items: stretch; }
.meta-page .quest-action .btn { min-width: 0; }
.quest-more { font-size: 22px; color: rgb(150, 172, 216); width: 100%; -unity-text-align: middle-center; margin: 4px 0 16px 0; }
.quest-day { font-size: 26px; color: rgb(255, 232, 170); margin-bottom: 8px; }

/* ---- 編隊 ---- */
.form-strip { margin: 12px 24px 0 24px; padding: 10px 22px; }
.form-strip-label { font-size: 26px; margin-right: 18px; }
.form-main { margin: 12px 24px 0 24px; }
.form-board { padding: 14px 18px 18px 18px; }
.form-footer {
    flex-direction: row; align-items: center; justify-content: space-between;
    margin: 14px 24px 18px 24px;
}
.form-count { font-size: 28px; color: rgb(255, 232, 170); }
.formation-label { font-size: 26px; }

/* ---- 地圖：底部進度膠囊 ---- */
.map-info { flex-direction: row; align-items: center; align-self: center; width: 760px; margin: 0 0 16px 0; padding: 8px 26px; border-radius: 30px; }
.map-info .txt-gold { margin: 0 20px 0 0; font-size: 26px; flex-shrink: 0; }
.map-info .bar-bg { flex-grow: 1; margin: 0; }

/* ---- 關卡面板 ---- */
.meta-page .overlay { align-items: center; justify-content: center; }
.stage-panel { width: 960px; padding: 24px 32px 28px 32px; }
.popup-close {
    position: absolute; right: 14px; top: 14px;
    width: 56px; height: 56px; margin: 0; padding: 0; border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("../UiSkin/btn_close.png");
    -unity-background-scale-mode: scale-to-fit;
}
.popup-close:hover { background-color: rgba(0, 0, 0, 0); scale: 1.1 1.1; }
.stage-head { margin: 0 56px 6px 0; }
.stage-cols { margin-top: 6px; }
.star-cond { flex-direction: row; align-items: center; margin: 3px 0; }
.star-cond-stars { width: 96px; font-size: 24px; color: rgb(255, 204, 70); }
.star-cond-text { font-size: 24px; color: rgb(184, 204, 244); }
.star-cond-on .star-cond-text { color: rgb(130, 232, 170); }
.stage-cost { margin: 12px 0 4px 0; }
.stage-buttons { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 16px; }
.stage-sweeps { flex-direction: row; }
.stage-sweeps .btn { margin-right: 12px; }

/* ---- 招募 ---- */
.gacha-tabs { margin: 16px 0 6px 0; }
.meta-page .gacha-actions .btn, .meta-page .gacha-actions .btn:hover { min-width: 320px; min-height: 100px; margin: 0 16px; font-size: 34px; }
.meta-page .pull-buttons .btn, .meta-page .pull-buttons .btn:hover { min-width: 280px; min-height: 96px; margin: 0 16px; font-size: 32px; }
.gacha-actions { margin: 0 0 24px 0; }
.gacha-info { width: 560px; }
.rate-chip { margin-right: 26px; }
.pull-tag { font-size: 22px; }

/* ---- 主城 ---- */
.home-bubble { width: 400px; }
.home-chapter { padding: 8px 20px; }
.home-chapter-sub { font-size: 24px; }

/* ---- 補充：按鈕內容置中、角標、招募陳列、編隊大卡 ---- */
.meta-page .btn, .meta-page .btn:hover { align-items: center; justify-content: center; }
.btn-tag {
    position: absolute; right: -6px; top: -14px;
    padding: 1px 12px;
    border-radius: 12px; border-width: 2px; border-color: white;
    background-color: rgb(228, 52, 42);
    font-size: 22px; -unity-font-style: bold; color: white;
}
.gacha-cost { align-self: center; }
.gacha-cost-label { margin-right: 14px; }
.gacha-showcase { margin-right: 56px; }
.gacha-card { margin: 0 12px; }
.gacha-card-main { margin: 0 12px; }
.htile-md { width: 190px; height: 250px; margin: 6px; }
.htile-md .htile-name { font-size: 24px; }
.htile-md .htile-stars { display: none; }
.htile-md .htile-role { width: 40px; height: 40px; }
.slot-md { width: 190px; height: 250px; margin: 6px; }
.form-board { align-self: flex-start; }
